# Database Connection (PostgreSQL with pgvector - e.g. Neon, Supabase, or local Docker)
DATABASE_URL="postgresql://synapse_user:synapse_password@localhost:5432/synapse_rag?schema=public"

# NextAuth / Auth.js Configuration
AUTH_SECRET="synapse_rag_super_secret_jwt_key_at_least_32_chars_long"
NEXTAUTH_URL="http://localhost:3000"

# Aval AI / LLM Configuration
AVAL_AI_API_KEY=""
AVAL_AI_BASE_URL="https://api.avalai.ir/v1"
AVAL_AI_MODEL="gpt-4o-mini"
AVAL_AI_EMBEDDING_MODEL="text-embedding-3-small"
